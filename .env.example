# ==============================================================================
# StockSense Backend Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# DO NOT commit real .env files with secrets into version control.
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Project Metadata
PROJECT_NAME="StockSense"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Database Configuration
# Local development default: SQLite
# Production requirement: PostgreSQL (e.g. postgresql://user:password@localhost:5432/stocksense)
DATABASE_URL="sqlite:///./stocksense.db"

# Security
# In production, this must be a cryptographically secure random string (minimum 32 characters)
SECRET_KEY="dev_insecure_secret_key_change_in_production_min32chars"

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "https://stocksense-self.vercel.app"]'

# Logging Level ('DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL')
LOG_LEVEL="INFO"
